FROM nginx

COPY index.html /usr/share/nginx/html

# Стандартний сервер "localhost" з образу nginx перехоплював запити на localhost
# і віддавав 404 замість відповіді з memcached. Прибираємо його, щоб працювали
# і localhost, і 127.0.0.1.
RUN rm -f /etc/nginx/conf.d/default.conf

ADD custom.conf /etc/nginx/conf.d

#EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
